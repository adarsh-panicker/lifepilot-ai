# LifePilot AI — Environment Configuration

# Application Port and Mode
PORT=3000
NODE_ENV=development

# Amazon Bedrock Configuration (Optional for Demo Mode, Required for Bedrock Mode)
# Leave blank to use Demo Mode (deterministic local assistant engine)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Standard AWS Credentials (Alternative to IAM roles or ~/.aws/credentials)
# NEVER commit your real credentials to git!
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Database configuration
DATABASE_PATH=./data/lifepilot.db
